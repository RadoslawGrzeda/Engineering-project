KAFKA_BOOTSTRAP_SERVERS=broker1:9094,broker2:9094,broker3:9094
KAFKA_TOPIC=transactions

DB_HOST=ods-db
DB_PORT=5432
DB_NAME=ods
DB_USER=ods
DB_PASSWORD=CHANGE_ME_ods_password

# Średnia procesu Poissona = (MIN+MAX)/2. Mniejsze wartości = częstsze transakcje.
HIPER_MIN_INTERVAL=0.5
HIPER_MAX_INTERVAL=1.5
SUPER_MIN_INTERVAL=1
SUPER_MAX_INTERVAL=3

# Inteligentny harmonogram (patrz scheduler.py)
TXN_ACTIVE_HOUR_START=6
TXN_ACTIVE_HOUR_END=24
# Dni wyłączone (0=pon ... 6=niedz). Domyślnie niedziela.
TXN_SKIP_WEEKDAYS=6
TXN_MAX_BATCH_SIZE=10
TXN_MIN_INTERVAL=0.05
TXN_MAX_INTERVAL=20
