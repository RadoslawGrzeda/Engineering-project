{
    "timestamp": {
        "$resolver": "timestamp",
        "pattern": {
            "format": "yyyy-MM-dd'T'HH:mm:ss"
        }
    },
    "level": {
        "$resolver": "level",
        "field": "name"
    },
    "logger": {
        "$resolver": "logger",
        "field": "name"
    },
    "message": {
        "$resolver": "message",
        "stringified": true
    },
    "correlation_id": {
        "$resolver": "mdc",
        "key": "correlation_id"
    },
    "service": {
        "$resolver": "mdc",
        "key": "service"
    },
    "partition": {
        "$resolver": "mdc",
        "key": "partition"
    },
    "offset": {
        "$resolver": "mdc",
        "key": "offset"
    },
    "error": {
        "$resolver": "exception",
        "field": "message"
    },
    "stacktrace": {
        "$resolver": "exception",
        "field": "stackTrace",
        "stringified": true
    }
}
