MINIO_ADDRESS=minio:9000
MINIO_USER=CHANGE_ME_minio_user
MINIO_PASSWORD=CHANGE_ME_minio_password

# ODS connection used by some DAGs. On a VPS replace host.docker.internal:5433
# with the in-network ods-db service (e.g. postgresql://ods:PASS@ods-db:5432/ods)
POSTGRES_CONNECTION=postgresql://ods:CHANGE_ME_ods_password@host.docker.internal:5433

# Airflow metadata DB
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=CHANGE_ME_airflow_db_password
AIRFLOW_DB_NAME=airflow

# Airflow Admin
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=CHANGE_ME_airflow_admin_password
AIRFLOW_ADMIN_EMAIL=admin@example.com

# ClickHouse (used by EL tasks + passed to dbt container via DockerOperator)
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=9000
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_USER=AdministratorClick
CLICKHOUSE_PASSWORD=CHANGE_ME_strong_clickhouse_admin_password
CLICKHOUSE_DB=default

# Postgres ODS (source for EL — used by ClickHouse postgresql() table function)
POSTGRES_ODS_HOST=ods-db
POSTGRES_ODS_PORT=5432
POSTGRES_ODS_USER=ods
POSTGRES_ODS_PASSWORD=CHANGE_ME_ods_password
POSTGRES_ODS_DB=ods

# dbt runtime (DockerOperator spawns this image, joined to DBT_NETWORK)
DBT_IMAGE=engineering-dbt:1.10
DBT_NETWORK=traefik_network
# Absolute path to the dbt project on the Docker host (change per host/VPS)
DBT_PROJECT_HOST_PATH=/path/to/Engineering-project/dbt
DBT_FULL_REFRESH=false
CLICKHOUSE_DBT_USER=dbt_runner
CLICKHOUSE_DBT_PASSWORD=CHANGE_ME_dbt_runner_password

# Backup (database_backup DAG)
MINIO_MC_IMAGE=minio/mc:latest
POSTGRES_BACKUP_IMAGE=postgres:16
CLICKHOUSE_BACKUP_IMAGE=clickhouse/clickhouse-server:24.12

MINIO_BACKUP_ENDPOINT=http://minio-backup:9000
MINIO_BACKUP_USER=backup-admin
MINIO_BACKUP_PASSWORD=CHANGE_ME_backup_minio_password
# Absolute path on the Docker host where backups are written (change per host/VPS)
BACKUP_HOST_PATH=/path/to/Engineering-project/backup/data
BACKUP_RETENTION_DAYS=30
BACKUP_BUCKET=database-backups
